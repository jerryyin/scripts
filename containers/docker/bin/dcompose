#!/usr/bin/env bash
set -euo pipefail

if (( $# == 0 )); then
    echo 'Usage: dcompose <docker compose arguments...>' >&2
    exit 2
fi

command_dir=$(dirname "$(readlink -f "$0")")
compose_file="${COMPOSE_FILE:-$command_dir/../docker-compose.yml}"
if [[ ! -f "$compose_file" ]]; then
    echo "Compose file not found: $compose_file" >&2
    exit 1
fi
compose_file=$(readlink -f "$compose_file")
case "$1" in
    -p|--project-name)
        if [[ $# -lt 3 || -z "$2" || "$2" == -* ]]; then
            echo 'Usage: dcompose -p <project> <command> [arguments...]' >&2
            exit 2
        fi
        export COMPOSE_PROJECT_NAME="$2"
        ;;
    --project-name=*) export COMPOSE_PROJECT_NAME="${1#*=}" ;;
esac
if [[ -z "${COMPOSE_PROJECT_NAME:-}" ]]; then
    case "$1" in
        build|config|ls|version) ;;
        *) echo 'Select an existing project: dcompose -p <project> <command>, or set COMPOSE_PROJECT_NAME.' >&2; exit 2 ;;
    esac
fi
exec docker compose -f "$compose_file" "$@"
