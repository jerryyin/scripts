#!/usr/bin/env bash
set -euo pipefail

if (( $# == 0 )); then
    echo 'Usage: dcompose <docker compose arguments...>' >&2
    exit 2
fi

command_dir=$(dirname "$(readlink -f "$0")")
compose_file="${COMPOSE_FILE:-$command_dir/../docker-compose.yml}"
if [[ ! -f "$compose_file" ]]; then
    echo "Compose file not found: $compose_file" >&2
    exit 1
fi
compose_file=$(readlink -f "$compose_file")
export COMPOSE_PROJECT_NAME="${USER:-$(id -un)}-${!#}-$(date +%m%d-%H%M)"
exec docker compose -f "$compose_file" "$@"
