#!/usr/bin/env bash
set -euo pipefail

if (( $# < 1 || $# > 2 )) || [[ "$1" == -* ]] || { (( $# == 2 )) && ! [[ "$2" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; }; then
    echo 'Usage: drun <service> [label]   (label: lowercase letters, digits, - and _)' >&2
    exit 2
fi
if [[ -n "${COMPOSE_PROJECT_NAME:-}" ]] && (( $# == 2 )); then
    echo 'A label extends the generated name; unset COMPOSE_PROJECT_NAME to use one.' >&2
    exit 2
fi

command_dir=$(dirname "$(readlink -f "$0")")
name="${COMPOSE_PROJECT_NAME:-${USER:-$(id -un)}-$1-$(date +%m%d-%H%M)${2:+-$2}}"
services=$(COMPOSE_PROJECT_NAME=$name "$command_dir/dcompose" --profile "$1" config --services)
if ! grep -Fxq -- "$1" <<< "$services"; then
    echo "Unknown Compose service: $1" >&2
    exit 2
fi
if [[ -z "${COMPOSE_PROJECT_NAME:-}" ]]; then
    # Not atomic: two druns started in the same minute can still choose the same name.
    taken=$(docker ps -a --format '{{.Names}} {{.Label "com.docker.compose.project"}}' | tr ' ' '\n')
    base=$name
    for (( n = 2; ; n++ )); do
        grep -Fxq -- "$name" <<< "$taken" || break
        name=$base-$n
    done
fi
export COMPOSE_PROJECT_NAME=$name
echo "Compose project: $COMPOSE_PROJECT_NAME"
exec "$command_dir/dcompose" up -d --no-build "$1"
