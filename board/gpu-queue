#!/usr/bin/env python3
"""A GPU job queue for a shared host with no scheduler: claim GPUs once, run queued jobs back to back.

usage: gpu-queue add DIR [--name NAME] [--count N] (--file SCRIPT | -- COMMAND...)
       gpu-queue status DIR
       gpu-queue serve DIR --count N [--container NAME] [--poll 1] [--confirm 2]
                       [--idle-by usage|process] [--log FILE] [--once]
                       [--reclaim-after SECONDS [--reclaim-grace 30]]

On a shared host, GPUs a finished job releases are taken by other users' queues before a
person can start the next job, and idle GPUs reserve nothing because other launches do not
check. So one claim must cover a sequence of jobs. `serve` holds no GPU while the queue is
empty; when a job is pending it waits for N idle GPUs (`gpu-wait.py N --hip`), then runs every
pending job on those GPUs, oldest first, starting each the moment the previous one exits,
including jobs added while earlier ones run. It releases the GPUs when the queue is empty and
goes back to waiting (or exits, with --once). It signals no process of another tenant unless
--reclaim-after is given.

A local serve holds the claimed GPUs' free memory from the claim until the queue is empty
(gpu-hold.py), yielding it while one of our processes uses the GPUs, so no other launcher takes
them between or during job starts. Jobs get the holder's process group in
GPU_ADMISSION_OWN_PGIDS so admission checks count it as ours.

One serve runs per DIR: it holds an flock on DIR/serve.lock, which records its --count, and exits
if another serve holds it. `add --count N` starts `serve DIR --count N --once` in the background
when no serve holds the lock, and refuses a job that needs more GPUs than the running serve
claims; without --count it refuses to queue into an unserved DIR. Serves of different DIRs do not
see each other's claims, so share one DIR per host.

--reclaim-after (host serve with --container only; every GPU process on the machine must be
yours): when a pending job has waited that many seconds without a claim, `serve` stops every
process on the host that has /dev/kfd open, except those in --container (SIGTERM, then SIGKILL
after --reclaim-grace seconds), logs each, and waits again. Listing and signalling go through
`sudo -n` unless `serve` runs as root. A serve inside the container cannot see other containers'
processes, so it cannot reclaim.

DIR holds pending/, running/, done/ and failed/. A job is an executable script; it runs with
HIP_VISIBLE_DEVICES, GPU_QUEUE_HIP and GPU_QUEUE_JOB set (and GPU_ADMISSION_OWN_PGIDS on a local serve), and its output and exit status land
beside it as <job>.log and <job>.exit. Without --container everything runs locally, which inside
a container is the simple setup. With --container, `serve` runs on the host (where
amd-smi sees every tenant) and reaches DIR and the job through `docker exec`, so DIR is a path
inside the container; `add` and `status` run wherever DIR is a local path, normally inside the
container. A job left in running/ by a crashed `serve` moves to failed/ with exit
`interrupted` when `serve` starts again.

All jobs in a queue use the same GPU count. Every claim, job start, exit status and GPU poll
(with the busy GPUs) is appended to --log: by default DIR/serve.log for a serve without
--container, else ~/.local/state/gpu-queue/<container>.log on the host. `status` shows how long
each pending or running job has waited, whether a serve holds DIR, and serve's last line from
DIR/serve.log; it flags STALE when jobs are queued or running and no serve holds DIR.
"""
from __future__ import annotations

import argparse
import dataclasses
import datetime as dt
import fcntl
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from pathlib import Path

GPU_WAIT = Path(__file__).resolve().with_name('gpu-wait.py')
GPU_HOLD = Path(__file__).resolve().with_name('gpu-hold.py')
STATES = ('pending', 'running', 'done', 'failed')
SERVE_LOG = 'serve.log'  # default --log of a serve without --container, inside DIR
LOCK = 'serve.lock'  # flock of DIR's one serve; holds its --count
LOCK_TRIES = 10  # 0.1 s apart, to ride out an add or status probing the lock
# Run inside the container: hold an flock on $1 until stdin closes, which the host serve's exit does.
HOLD_LOCK = 'exec 9>>"$1" && flock -n 9 && printf "%s\\n" "$2" > "$1" && echo locked && exec cat > /dev/null'
JOB_RE = re.compile(r'^[0-9TZ-]+-[A-Za-z0-9._-]+\.sh$')
NAME_RE = re.compile(r'^[A-Za-z0-9._-]+$')
NO_TIME_LIMIT = str(10 ** 9)  # seconds; gpu-wait.py has no "wait forever" value


@dataclasses.dataclass(frozen=True)
class Store:
    """Queue directory operations, run locally or inside a container through docker exec."""
    root: str
    container: str | None = None

    def sh(self, script: str, *args: str, check: bool = True,
           env: dict[str, str] | None = None, capture: bool = True) -> subprocess.CompletedProcess:
        env = env or {}
        if self.container:
            prefix = ['docker', 'exec', *[f'-e{k}={v}' for k, v in env.items()], self.container]
            child_env = None
        else:
            prefix, child_env = [], {**os.environ, **env}
        return subprocess.run([*prefix, 'sh', '-c', script, 'gpu-queue', self.root, *args],
                              capture_output=capture, text=True, check=check, env=child_env)

    def init(self) -> None:
        self.sh('cd "$1" 2>/dev/null || mkdir -p "$1"; mkdir -p "$1/pending" "$1/running" "$1/done" "$1/failed"')

    def jobs(self, state: str) -> list[str]:
        out = self.sh('ls -1 "$1/$2" 2>/dev/null || true', state).stdout.split()
        return sorted(name for name in out if JOB_RE.match(name))

    def move(self, job: str, src: str, dst: str) -> None:
        self.sh('mv "$1/$2/$4" "$1/$3/$4" && { [ ! -e "$1/$2/$4.log" ] || mv "$1/$2/$4.log" "$1/$3/"; }',
                src, dst, job)

    def write_exit(self, job: str, state: str, value: str) -> None:
        self.sh('printf "%s\\n" "$4" > "$1/$2/$3.exit"', state, job, value)

    def run(self, job: str, hip: str, extra_env: dict[str, str] | None = None) -> int:
        env = {'HIP_VISIBLE_DEVICES': hip, 'GPU_QUEUE_HIP': hip, 'GPU_QUEUE_JOB': job, **(extra_env or {})}
        result = self.sh('cd "$1/running" && exec bash -lc \'exec "./$0" > "./$0.log" 2>&1\' "$2"',
                         job, check=False, env=env, capture=False)
        return result.returncode


class ServeLock:
    """DIR's serve lock, held by this process or, with --container, by a `docker exec` child."""

    def __init__(self, store: Store, count: int):
        self.path, self.container, self.count = f'{store.root}/{LOCK}', store.container, count
        self.holder = None

    def _try(self):
        if self.container:
            child = subprocess.Popen(['docker', 'exec', '-i', self.container, 'sh', '-c', HOLD_LOCK,
                                      'gpu-queue', self.path, str(self.count)],
                                     stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
            if child.stdout.readline().strip() == 'locked':
                return child
            child.wait()
            return None
        fh = open(self.path, 'a+')
        try:
            fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            fh.close()
            return None
        fh.truncate(0)
        fh.write(f'{self.count}\n')
        fh.flush()
        return fh

    def acquire(self) -> bool:
        for attempt in range(LOCK_TRIES):
            if attempt:
                time.sleep(0.1)
            self.holder = self._try()
            if self.holder:
                return True
        return False

    def release(self) -> None:
        if self.container:
            self.holder.stdin.close()
            self.holder.wait()
        else:
            self.holder.close()
        self.holder = None


def serving(queue: Path) -> int | None:
    """--count of the serve holding local DIR `queue` (0 if unreadable), or None if none does."""
    path = queue / LOCK
    if not path.exists():
        return None
    with path.open('a+') as fh:
        try:
            fcntl.flock(fh, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except BlockingIOError:
            fh.seek(0)
            text = fh.read().strip()
            return int(text) if text.isdigit() else 0
    return None


def start_serve(queue: Path, count: int) -> int:
    """Start `serve DIR --count N --once` detached, its errors appended to DIR/serve.log; its PID."""
    with (queue / SERVE_LOG).open('a') as log:
        child = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), 'serve',
                                  str(queue.resolve()), '--count', str(count), '--once'],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=log,
                                 start_new_session=True)
    return child.pid


def note(log: Path, message: str) -> None:
    line = f'{dt.datetime.now().astimezone():%Y-%m-%dT%H:%M:%S%z} {message}'
    with log.open('a') as fh:
        fh.write(line + '\n')
    print(line, flush=True)


def wait_for_gpus(args: argparse.Namespace, log: Path) -> str | None:
    """HIP ids of args.count idle GPUs from gpu-wait.py; None if args.reclaim_after passes first."""
    timeout = str(args.reclaim_after) if args.reclaim_after else NO_TIME_LIMIT
    cmd = [sys.executable, str(GPU_WAIT), str(args.count), '--hip', '--idle-by', args.idle_by,
           '--poll', str(args.poll), '--confirm', str(args.confirm), '--timeout', timeout,
           '--log', str(log)]
    result = subprocess.run(cmd, capture_output=True, text=True)
    hip = result.stdout.strip()
    if result.returncode == 1 and not hip and args.reclaim_after:
        return None
    if result.returncode != 0 or not hip:
        raise SystemExit(f'gpu-wait.py failed ({result.returncode}): {result.stderr.strip()}')
    return hip


# Run inside the named container: PID and command line of each process with /dev/kfd open,
# except PID 1 (stopping it would stop the container).
KFD_HOLDERS = r'''for d in /proc/[0-9]*; do
  p=${d#/proc/}; [ "$p" = 1 ] && continue
  for f in "$d"/fd/*; do
    if [ "$(readlink "$f" 2>/dev/null)" = /dev/kfd ]; then
      printf '%s\t%s\n' "$p" "$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)"; break
    fi
  done
done'''


def parse_holders(text: str) -> list[tuple[int, str]]:
    holders = []
    for line in text.splitlines():
        pid, _, cmd = line.partition('\t')
        if pid.isdigit() and int(pid) != 1:
            holders.append((int(pid), cmd.strip()))
    return holders


def as_root(argv: list[str]) -> list[str]:
    return argv if os.geteuid() == 0 else ['sudo', '-n', *argv]


def container_id(name: str) -> str:
    result = subprocess.run(['docker', 'inspect', '-f', '{{.Id}}', name], capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        raise SystemExit(f'cannot resolve container {name!r}: {result.stderr.strip()}')
    return result.stdout.strip()


def kfd_holders(spare: str | None = None) -> list[tuple[int, str]]:
    """/dev/kfd holders visible here, minus processes whose cgroup names container id `spare`."""
    result = subprocess.run(as_root(['sh', '-c', KFD_HOLDERS]), capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f'cannot list GPU processes: {result.stderr.strip()}')
    holders = parse_holders(result.stdout)
    if spare:
        holders = [(pid, cmd) for pid, cmd in holders if spare not in _cgroup(pid)]
    return holders


def _cgroup(pid: int) -> str:
    try:
        return Path(f'/proc/{pid}/cgroup').read_text()
    except OSError:
        return ''


def reclaim(spare: str | None, grace: int, log: Path) -> None:
    """Stop every /dev/kfd holder outside container id `spare` (SIGTERM, SIGKILL after `grace` s)."""
    try:
        holders = kfd_holders(spare)
    except RuntimeError as error:
        note(log, f'reclaim: {error}; nothing signalled')
        return
    if not holders:
        note(log, 'reclaim: no other process has /dev/kfd open')
        return
    for pid, cmd in holders:
        note(log, f'reclaim: SIGTERM pid {pid} ({cmd[:200]})')
    subprocess.run(as_root(['kill', '-TERM', *(str(pid) for pid, _ in holders)]), capture_output=True)
    deadline = time.monotonic() + grace
    left = {pid for pid, _ in holders}
    while time.monotonic() < deadline:
        left &= {pid for pid, _ in kfd_holders(spare)}
        if not left:
            note(log, f'reclaim: all {len(holders)} process(es) exited')
            return
        time.sleep(1)
    for pid in sorted(left):
        note(log, f'reclaim: SIGKILL pid {pid} (still running after {grace}s)')
    subprocess.run(as_root(['kill', '-KILL', *map(str, sorted(left))]), capture_output=True)


def recover(store: Store, log: Path) -> None:
    for job in store.jobs('running'):
        store.move(job, 'running', 'failed')
        store.write_exit(job, 'failed', 'interrupted')
        note(log, f'{job}: found in running/ at start, moved to failed/ (interrupted)')


def drain(store: Store, hip: str, log: Path, extra_env: dict[str, str] | None = None) -> None:
    """Run pending jobs on `hip`, oldest first, until none is left."""
    while pending := store.jobs('pending'):
        job = pending[0]
        store.move(job, 'pending', 'running')
        store.sh('touch "$1/running/$2"', job)  # its mtime is the start time `status` reports
        note(log, f'{job}: start on HIP {hip}')
        status = store.run(job, hip, extra_env)
        state = 'done' if status == 0 else 'failed'
        store.move(job, 'running', state)
        store.write_exit(job, state, str(status))
        note(log, f'{job}: exit={status} -> {state}/')


class MemoryHold:
    """gpu-hold.py on the claimed GPUs, in its own process group, from start() to stop()."""

    def __init__(self, hip: str, log: Path):
        self.hip, self.log = hip, log
        self.process: subprocess.Popen | None = None

    def start(self) -> dict[str, str]:
        """Start holding; returns the job environment naming the holder's process group."""
        self.process = subprocess.Popen(
            [sys.executable, str(GPU_HOLD), '--hip', self.hip, '--log', str(self.log)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, start_new_session=True)
        return {'GPU_ADMISSION_OWN_PGIDS': str(self.process.pid)}

    def stop(self) -> None:
        if self.process is None:
            return
        self.process.terminate()
        try:
            self.process.wait(60)
        except subprocess.TimeoutExpired:
            os.killpg(self.process.pid, signal.SIGKILL)  # its own group: the holder and its children
            self.process.wait()
        self.process = None


def serve(args: argparse.Namespace, store: Store, log: Path, wait=wait_for_gpus,
          reclaim=reclaim, lock: ServeLock | None = None, hold=MemoryHold) -> int:
    store.init()
    lock = lock or ServeLock(store, args.count)
    if not lock.acquire():
        note(log, f'another serve holds {store.root}/{LOCK}; exiting')
        return 1
    recover(store, log)
    note(log, f'serving {store.root} ({args.container or "local"}), {args.count} GPUs per claim')
    spare = container_id(args.container) if args.reclaim_after and args.container else None
    while True:
        if not store.jobs('pending'):
            if args.once:
                lock.release()
                # Look again: an add that probed just before the release saw a serve and started none.
                if not store.jobs('pending'):
                    note(log, 'queue empty; --once, exiting')
                    return 0
                if not lock.acquire():
                    note(log, 'a job arrived as this serve stopped; another serve has the queue')
                    return 0
                continue
            time.sleep(args.poll)
            continue
        note(log, f'{len(store.jobs("pending"))} job(s) pending; waiting for {args.count} idle GPUs')
        while (hip := wait(args, log)) is None:
            note(log, f'no claim after {args.reclaim_after}s; reclaiming')
            reclaim(spare, args.reclaim_grace, log)
        note(log, f'claimed HIP {hip}')
        holder = None if args.container else hold(hip, log)
        try:
            drain(store, hip, log, holder.start() if holder else None)
        finally:
            if holder:
                holder.stop()
        note(log, f'queue empty; released HIP {hip}')


def add(args: argparse.Namespace, spawn=start_serve) -> int:
    if args.file and args.command:
        raise SystemExit('give --file or a command, not both')
    if args.file:
        body = Path(args.file).read_text()
        name = args.name or Path(args.file).stem
    else:
        command = args.command[0] if len(args.command) == 1 else shlex.join(args.command)
        if not command:
            raise SystemExit('give --file SCRIPT or -- COMMAND')
        body = f'#!/usr/bin/env bash\n{command}\n'
        name = args.name or 'job'
    if not NAME_RE.match(name):
        raise SystemExit(f'job name {name!r} may use only letters, digits, ".", "_" and "-"')
    queue = Path(args.dir)
    count = serving(queue)
    if count is None and not args.count:
        raise SystemExit(f'no serve is running for {queue}; pass --count N to start one')
    if count and args.count and args.count > count:
        raise SystemExit(f'the serve for {queue} claims {count} GPUs; this job needs {args.count}')
    for state in STATES:
        (queue / state).mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now(dt.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
    job = queue / 'pending' / f'{stamp}-{name}.sh'
    tmp = queue / 'pending' / f'.{job.name}.tmp'
    tmp.write_text(body)
    tmp.chmod(0o755)
    os.replace(tmp, job)  # atomic: serve never sees a half-written job
    print(job)
    if serving(queue) is None:  # also a --once serve that stopped after the check above
        if args.count:
            pid = spawn(queue, args.count)
            print(f'started serve {pid} for {args.count} GPUs; log: {queue / SERVE_LOG}', file=sys.stderr)
        else:
            print(f'warning: no serve holds {queue} now; if the job stays pending, run '
                  f'`gpu-queue serve {queue} --count N`', file=sys.stderr)
    return 0


def _age(seconds: float) -> str:
    return f'{int(seconds // 3600)}h{int(seconds % 3600 // 60):02d}m' if seconds >= 3600 else f'{int(seconds // 60)}m'


def status(args: argparse.Namespace, now: float | None = None) -> int:
    """Jobs by state, how long pending and running jobs have waited, the serve, its last log line."""
    queue = Path(args.dir)
    now = time.time() if now is None else now
    for state in STATES:
        names = sorted(p.name for p in (queue / state).glob('*.sh')) if (queue / state).is_dir() else []
        print(f'{state}: {len(names)}')
        for name in names:
            exit_file = queue / state / f'{name}.exit'
            suffix = f'  exit={exit_file.read_text().strip()}' if exit_file.exists() else ''
            if state in ('pending', 'running'):
                since = (queue / state / name).stat().st_mtime if state == 'running' else \
                    dt.datetime.strptime(name.split('-', 1)[0], '%Y%m%dT%H%M%S%fZ').replace(
                        tzinfo=dt.timezone.utc).timestamp()
                suffix = f'  {"queued" if state == "pending" else "started"} {_age(now - since)} ago'
            print(f'  {name}{suffix}')
    count = serving(queue)
    print('serve: none' if count is None else f'serve: running, {count or "?"} GPUs per claim')
    log = queue / SERVE_LOG
    if log.exists():
        lines = log.read_text().splitlines()
        print(f'serve log ({log}): last write {_age(now - log.stat().st_mtime)} ago')
        if lines:
            print(f'  {lines[-1][:300]}')
    busy = any((queue / s).is_dir() and any((queue / s).glob('*.sh')) for s in ('pending', 'running'))
    if busy and count is None:
        print(f'STALE: jobs are queued or running but no serve holds {queue}; '
              f'run `gpu-queue serve {queue} --count N`')
    return 0


def parse(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='cmd', required=True)
    p = sub.add_parser('add', help='queue a job (run where DIR is local)')
    p.add_argument('dir')
    p.add_argument('--name')
    p.add_argument('--file')
    p.add_argument('--count', type=int, help='GPUs the job needs; starts a serve for that many if none runs')
    p = sub.add_parser('status', help='list jobs by state (run where DIR is local)')
    p.add_argument('dir')
    p = sub.add_parser('serve', help='claim GPUs and run queued jobs (run on the host)')
    p.add_argument('dir')
    p.add_argument('--count', type=int, required=True)
    p.add_argument('--container')
    p.add_argument('--poll', type=float, default=1)  # other launchers take freed GPUs within seconds
    p.add_argument('--confirm', type=int, default=2)  # a loaded server reads 0% between requests
    p.add_argument('--idle-by', choices=('usage', 'process'), default='usage')
    p.add_argument('--log', type=Path)
    p.add_argument('--once', action='store_true', help='exit when the queue is empty')
    p.add_argument('--reclaim-after', type=int, metavar='SECONDS',
                   help='host serve only: stop GPU processes outside --container after a job '
                        'waits this long')
    p.add_argument('--reclaim-grace', type=int, default=30,
                   help='seconds between SIGTERM and SIGKILL')
    argv = sys.argv[1:] if argv is None else argv
    # Everything after "--" is the job's command, never options of gpu-queue.
    command = argv[argv.index('--') + 1:] if '--' in argv else []
    args = parser.parse_args(argv[:argv.index('--')] if '--' in argv else argv)
    args.command = command
    if args.cmd == 'serve' and args.reclaim_after is not None and not args.container:
        parser.error('--reclaim-after needs --container: a serve inside a container cannot see '
                     "other containers' processes")
    return args


def main(argv: list[str] | None = None) -> int:
    args = parse(argv)
    if args.cmd == 'add':
        return add(args)
    if args.cmd == 'status':
        return status(args)
    if args.log:
        log = args.log
    elif args.container:
        log = Path.home() / '.local/state/gpu-queue' / f'{args.container}.log'
    else:  # local serve: keep the log beside the jobs, where `status` reads it
        log = Path(args.dir) / SERVE_LOG
    log.parent.mkdir(parents=True, exist_ok=True)
    return serve(args, Store(args.dir, args.container), log)


if __name__ == '__main__':
    sys.exit(main())
