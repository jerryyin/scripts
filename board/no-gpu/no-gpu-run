#!/usr/bin/env bash
# no-gpu-run [--log FILE] -- COMMAND [ARG...]
# Run COMMAND (and its children) with every open of /dev/kfd and /dev/dri/* refused (EACCES) and
# logged, so CPU-only work (unit tests, offline compiles) never opens a GPU that other users hold.
# The LD_PRELOAD shim nokfd.c is built on first use into $NO_GPU_CACHE (default
# ${XDG_CACHE_HOME:-$HOME/.cache}/no-gpu) and rebuilt when the source changes. GPU selection
# variables are unset and core dumps are off. Blocked opens are appended to the log (default
# $NO_GPU_CACHE/blocked.log): "BLOCKED open PATH pid=PID".
set -euo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
LOG=""
while [[ $# -gt 0 ]]; do
  case $1 in
    --log) LOG=$2; shift 2 ;;
    --) shift; break ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *) break ;;
  esac
done
[[ $# -gt 0 ]] || { echo "usage: no-gpu-run [--log FILE] -- COMMAND [ARG...]" >&2; exit 2; }
CACHE=${NO_GPU_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/no-gpu}
mkdir -p "$CACHE"
SUM=$(sha256sum "$HERE/nokfd.c" | cut -c1-16)
LIB=$CACHE/libnokfd-$SUM.so
if [[ ! -f $LIB ]]; then
  ${CC:-cc} -shared -fPIC -O2 -o "$LIB.tmp.$$" "$HERE/nokfd.c" -ldl
  mv "$LIB.tmp.$$" "$LIB"
fi
export LD_PRELOAD="$LIB${LD_PRELOAD:+:$LD_PRELOAD}" KFD_GUARD_LOG="${LOG:-$CACHE/blocked.log}"
export PYTORCH_NVML_BASED_CUDA_CHECK=1
unset ROCR_VISIBLE_DEVICES HIP_VISIBLE_DEVICES CUDA_VISIBLE_DEVICES
ulimit -c 0
exec "$@"
