  {"name": "add/post-comm (TP4 all-reduce)", "categories": ["ffn.add+post_comm(allreduce)"], "markers": ["moe.join"]},
  {"name": "layer tail (ffn.end->next layer)", "categories": ["layer_tail"], "markers": ["ffn.end"]},
  {"name": "final norm", "categories": ["final_norm"], "markers": ["final"]},
  {"name": "lm_head+sampling+outputs", "categories": ["lm_head+sampling+outputs"], "markers": ["model.end"]}
 ],
