  {"name": "norms/mHC pre-ffn", "categories": ["mhc+norm(pre-ffn)"], "markers": ["hc_ffn"]},
  {"name": "ffn.pre_comm", "categories": ["ffn.pre_comm"], "markers": ["ffn"]},
