  {"name": "Petit Stage2 (down)", "categories": ["petit.stage2(down)"], "markers": ["petit.s2"]},
  {"name": "Petit Combine", "categories": ["petit.combine"], "markers": ["petit.comb"]},
  {"name": "Petit post (petit.post->next; analyzer label moe.shared_join_wait)", "categories": ["moe.shared_join_wait"], "markers": ["petit.post"]},
