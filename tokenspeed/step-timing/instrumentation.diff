+++ b/python/tokenspeed/runtime/utils/step_timing.py
@@ -0,0 +1,254 @@
+"""TEST-ONLY decode-step component timing (campaign instrumentation, not upstream).
+
+Off unless TS_STEP_TIMING=1. Records torch.cuda.Event(enable_timing=True,
+external=True) at component boundaries while a decode graph is captured, so the
+graph contains event-record nodes (hipEventRecordWithFlags(..., External)).
+After a sampled replay the next replay first reads all elapsed times relative
+to an ordinary event recorded just before graph.replay() and appends one JSON
+line per sampled step to $TS_STEP_TIMING_DIR/step-timing-r<rank>-p<pid>.jsonl.
+
+Env:
+  TS_STEP_TIMING=1                 enable
+  TS_STEP_TIMING_DIR=<dir>         output dir (required when enabled)
+  TS_STEP_TIMING_EVERY=<k>         harvest every k-th replay (default 4)
+  TS_STEP_TIMING_MAX_RECORDS=<n>   stop harvesting after n records (default 4000)
+  TS_STEP_TIMING_LAYER_STRIDE=<s>  only instrument layers with id % s == 0 (default 1)
+  TS_STEP_TIMING_EAGER=1           fallback: also time eager (no-graph) decode forwards
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import time
+
+import torch
+
+ENABLED = os.environ.get("TS_STEP_TIMING", "0") == "1"
+_DIR = os.environ.get("TS_STEP_TIMING_DIR", "")
+_EVERY = max(1, int(os.environ.get("TS_STEP_TIMING_EVERY", "4")))
+_MAX = int(os.environ.get("TS_STEP_TIMING_MAX_RECORDS", "4000"))
+_STRIDE = max(1, int(os.environ.get("TS_STEP_TIMING_LAYER_STRIDE", "1")))
+_EAGER = os.environ.get("TS_STEP_TIMING_EAGER", "0") == "1"
+
+
+class _Seq:
+    __slots__ = ("sid", "pool", "names", "streams", "main", "dropped", "written")
+
+    def __init__(self, sid, pool, main):
+        self.sid, self.pool, self.main = sid, pool, main
+        self.names, self.streams = [], []
+        self.dropped, self.written = 0, False
+
+
+class _State:
+    seqs: dict = {}
+    cur: _Seq | None = None
+    eager: _Seq | None = None
+    eager_active = False
+    eager_cursor = 0
+    cur_layer = -1
+    pool_hint = 1024
+    replays = 0
+    records = 0
+    pending = None
+    buf: list = []
+    path = None
+    next_sid = 0
+
+
+_S = _State
+
+
+def _rank():
+    try:
+        import torch.distributed as dist
+
+        if dist.is_available() and dist.is_initialized():
+            return dist.get_rank()
+    except Exception:
+        pass
+    return -1
+
+
+def _write(obj):
+    if _S.path is None:
+        os.makedirs(_DIR, exist_ok=True)
+        _S.path = os.path.join(_DIR, f"step-timing-r{_rank()}-p{os.getpid()}.jsonl")
+    _S.buf.append(json.dumps(obj, separators=(",", ":")))
+    if len(_S.buf) >= 16 or obj.get("type") != "step":
+        with open(_S.path, "a") as f:
+            f.write("\n".join(_S.buf) + "\n")
+        _S.buf = []
+
+
+def _new_seq(n):
+    stream = torch.cuda.current_stream()
+    pool = []
+    for _ in range(n):
+        ev = torch.cuda.Event(enable_timing=True, external=True)
+        ev.record(stream)  # creates the hipEvent outside capture
+        pool.append(ev)
+    sid = _S.next_sid
+    _S.next_sid += 1
+    # The main (capture) stream is the stream of the first mark, not this one.
+    return _Seq(sid, pool, None)
+
+
+def layer_on(layer_id: int) -> bool:
+    return ENABLED and layer_id % _STRIDE == 0
+
+
+def mark(name: str, layer: int | None = None) -> None:
+    """Record a boundary event on the current stream (no-op unless enabled).
+
+    layer=None uses the last layer id passed to mark (kernel-library hooks).
+    """
+    if not ENABLED:
+        return
+    if layer is None:
+        layer = _S.cur_layer
+    elif layer >= 0:
+        _S.cur_layer = layer
+    if layer >= 0 and layer % _STRIDE:
+        return
+    seq = _S.cur
+    if seq is None:
+        if not (_S.eager_active and _S.eager is not None):
+            return
+        seq = _S.eager
+    elif not torch.cuda.is_current_stream_capturing():
+        return
+    i = len(seq.names) if not (seq is _S.eager and seq.written) else _S.eager_cursor
+    if i >= len(seq.pool):
+        seq.dropped += 1
+        return
+    stream = torch.cuda.current_stream()
+    if seq.main is None:
+        seq.main = stream
+    seq.pool[i].record(stream)
+    if seq is _S.eager and seq.written:
+        _S.eager_cursor = i + 1
+        return
+    seq.names.append(f"{layer}:{name}")
+    seq.streams.append("main" if stream == seq.main else f"s{stream.stream_id}")
+
+
+def capture_begin(graph) -> None:
+    """Call immediately before the decode graph capture starts (outside capture)."""
+    if not ENABLED:
+        return
+    seq = _new_seq(_S.pool_hint)
+    _S.seqs[id(graph)] = seq
+    _S.cur = seq
+
+
+def capture_end(graph, bs=None) -> None:
+    if not ENABLED or _S.cur is None:
+        return
+    seq = _S.cur
+    _S.cur = None
+    _S.pool_hint = max(_S.pool_hint, len(seq.names) + 64)
+    _write({"type": "seq", "sid": seq.sid, "bs": bs, "names": seq.names,
+            "streams": seq.streams, "dropped": seq.dropped, "pid": os.getpid(),
+            "rank": _rank(), "stride": _STRIDE, "every": _EVERY})
+    seq.written = True
+
+
+def _harvest():
+    p = _S.pending
+    _S.pending = None
+    if p is None:
+        return
+    seq, begin, end, meta = p
+    h0 = time.perf_counter()
+    end.synchronize()
+    n = len(seq.names)
+    t = [round(begin.elapsed_time(seq.pool[i]), 5) for i in range(n)]
+    meta["graph_ms"] = round(begin.elapsed_time(end), 5)
+    meta["t"] = t
+    meta["harvest_ms"] = round((time.perf_counter() - h0) * 1e3, 4)
+    _write(meta)
+    _S.records += 1
+
+
+def before_replay(graph, ctx=None, bs=None, padded_bs=None):
+    """Call right before graph.replay(); returns a token for after_replay."""
+    if not ENABLED:
+        return None
+    _harvest()
+    _S.replays += 1
+    seq = _S.seqs.get(id(graph))
+    if seq is None or _S.records >= _MAX or _S.replays % _EVERY:
+        return None
+    begin = torch.cuda.Event(enable_timing=True)
+    begin.record()
+    gnt = getattr(ctx, "global_num_tokens", None) if ctx is not None else None
+    meta = {"type": "step", "sid": seq.sid, "replay": _S.replays,
+            "wall": time.time(), "bs": bs, "padded_bs": padded_bs,
+            "global_num_tokens": list(gnt) if gnt is not None else None,
+            "input_num_tokens": getattr(ctx, "input_num_tokens", None)}
+    return (seq, begin, meta)
+
+
+def after_replay(token) -> None:
+    if token is None:
+        return
+    seq, begin, meta = token
+    end = torch.cuda.Event(enable_timing=True)
+    end.record()
+    _S.pending = (seq, begin, end, meta)
+
+
+def eager_begin(ctx=None, bs=None):
+    """Fallback (TS_STEP_TIMING_EAGER=1): wrap an eager decode forward."""
+    if not (ENABLED and _EAGER):
+        return None
+    _harvest()
+    if _S.eager is None:
+        _S.eager = _new_seq(_S.pool_hint)
+    _S.eager_cursor = 0
+    _S.eager_active = True
+    _S.replays += 1
+    begin = torch.cuda.Event(enable_timing=True)
+    begin.record()
+    gnt = getattr(ctx, "global_num_tokens", None) if ctx is not None else None
+    meta = {"type": "step", "sid": _S.eager.sid, "replay": _S.replays, "eager": True,
+            "wall": time.time(), "bs": bs, "padded_bs": bs,
+            "global_num_tokens": list(gnt) if gnt is not None else None,
+            "input_num_tokens": getattr(ctx, "input_num_tokens", None)}
+    return (_S.eager, begin, meta)
+
+
+def eager_end(token) -> None:
+    if token is None:
+        return
+    seq, begin, meta = token
+    _S.eager_active = False
+    if not seq.written:
+        _write({"type": "seq", "sid": seq.sid, "bs": None, "eager": True,
+                "names": seq.names, "streams": seq.streams, "dropped": seq.dropped,
+                "pid": os.getpid(), "rank": _rank(), "stride": _STRIDE, "every": 1})
+        seq.written = True
+    elif _S.eager_cursor != len(seq.names):
+        meta["marker_mismatch"] = _S.eager_cursor
+    if _S.records >= _MAX:
+        return
+    end = torch.cuda.Event(enable_timing=True)
+    end.record()
+    _S.pending = (seq, begin, end, meta)
+
+
+def flush() -> None:
+    if ENABLED and _S.buf and _S.path:
+        with open(_S.path, "a") as f:
+            f.write("\n".join(_S.buf) + "\n")
+        _S.buf = []
+
+
+if ENABLED:
+    import atexit
+
+    if not _DIR:
+        raise RuntimeError("TS_STEP_TIMING=1 requires TS_STEP_TIMING_DIR")
+    atexit.register(flush)
