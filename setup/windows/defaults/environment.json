{
    "notesRepository": "https://github.com/jerryyin/notes.git",
    "rcRepository": "https://github.com/jerryyin/rc_files.git",
    "vaultRepositories": {
        "homelab": "https://github.com/jerryyin/vault-homelab.git",
        "work": "https://github.com/jerryyin/vault-work.git"
    },
    "wsl": {
        "distribution": "Ubuntu"
    },
    "packages": [
        {
            "id": "Git.Git",
            "scope": "machine"
        },
        {
            "id": "Python.Python.3.14",
            "scope": "machine",
            "installerArguments": "InstallAllUsers=1 InstallLauncherAllUsers=1 Include_launcher=1 PrependPath=1 Include_exe=1 Include_lib=1 Include_pip=1"
        },
        {
            "id": "Obsidian.Obsidian",
            "scope": "machine"
        },
        {
            "id": "Microsoft.PowerToys",
            "scope": "machine"
        },
        {
            "id": "KDE.KDEConnect",
            "scope": "machine",
            "userAppxNames": ["KDEe.V.KDEConnect"]
        },
        {
            "id": "Rufus.Rufus",
            "scope": "machine"
        },
        {
            "id": "AntibodySoftware.WizTree",
            "scope": "machine"
        },
        {
            "id": "VideoLAN.VLC",
            "scope": "machine"
        },
        {
            "id": "7zip.7zip",
            "scope": "machine"
        }
    ]
}
